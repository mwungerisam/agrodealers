# Copy to .env and use the URL and publishable key of your own Supabase project.
# Both pairs must identify the SAME project. VITE_ values are public build inputs.
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional first-owner setup screen. Disable after creating the first owner.
# Supabase Auth must also allow signups during bootstrap; this is only a UI flag.
VITE_ENABLE_OWNER_SIGNUP=false

# Do not put service-role keys, database passwords or access tokens in VITE_ vars.
# The create-worker Edge Function receives its service key from Supabase itself.
